# secrets.toml.example
# Copy this file to secrets.toml and fill in your actual values.
# NEVER commit secrets.toml — it is gitignored.

[server]
debug = true

[mcp_host]
test_mode = false
# test_mode = true  # Test Mode: real MCP calls, mocked LLM completion
test_mode_verbose_json = true
test_mode_scenario_path = "ai_gateway/services/mcp/test_mode/scenarios/default.json"
test_mode_discovery_on_startup = true
test_mode_store_system_logs = true
test_mode_max_payload_chars = 4000
test_mode_visible_band_limit = 20
test_mode_raw_bytes_limit = 16384
test_mode_redact_headers = true
test_mode_allow_remote_mcp = false

[mcp_host.doc_search]
max_docs = 10
snippet_chars = 1500
prompt_max_per_doc = 3
prompt_compact_max_total = 6
prompt_compact_max_total_chars = 6000
prompt_default_max_total = 9
prompt_default_max_total_chars = 9000
prompt_expand_max_total = 12
prompt_expand_max_total_chars = 12000
prompt_file_filter_max_per_doc = 12
prompt_file_filter_max_total = 12
prompt_file_filter_max_total_chars = 14000
prompt_file_fallback_max_files = 4

[auth]
admin_signup_key = "change-me"

[fabrix_agent_api]
base_url = "https://YOUR_FABRIX_AGENT_API_URL"
client_key = "YOUR_CLIENT_KEY"
openapi_token = "Bearer YOUR_OPENAPI_TOKEN"
api_id = "YOUR_API_ID"
user_email = "your@email.com"

[fabrix_chat_api]
base_url = "https://YOUR_FABRIX_CHAT_API_URL"
client_key = "YOUR_CLIENT_KEY"
openapi_token = "Bearer YOUR_OPENAPI_TOKEN"
model_id = "YOUR_MODEL_ID"
user_email = "your@email.com"

[security]
django_secret_key = "change-me-to-a-long-random-secret"
allowed_hosts = ["localhost", "127.0.0.1"]

# =============================================================================
# MCP Providers
# =============================================================================
# Each MCP provider is configured under [mcp.providers.<provider_id>].
# Providers are loaded dynamically — adding a new provider only requires
# adding a new [mcp.providers.<id>] section here and registering its manifest
# in ai_gateway/services/mcp/providers/__init__.py.

# Provider 1: internal_docs (Phase 1) — fastmcp doc-search server
# Server path: C:\Users\BgKing\mycode\fastmcp
# Start: cd ..\fastmcp && run_server.bat
[mcp.providers.internal_docs]
display_name = "fastmcp-doc-search"
transport = "streamable_http"
base_url = "http://127.0.0.1:8002/mcp"
kind = "remote"
enabled = true
origin_type = "local"
activation_rule_ref = "internal_docs.default"

# Provider 2: lexguard (Phase 4) — lexguard-mcp legal QA server
# Server path: C:\Users\BgKing\mycode\lexguard-mcp  (external folder, separate venv)
# Start (local): cd ..\lexguard-mcp && .venv\Scripts\activate && python -m src.main
# Or use remote:  base_url = "https://lexguard-mcp.onrender.com/mcp"
[mcp.providers.lexguard]
display_name = "lexguard-mcp"
transport = "streamable_http"
base_url = "http://127.0.0.1:9099/mcp"
# base_url = "https://lexguard-mcp.onrender.com/mcp"  # 원격 서버 사용 시
kind = "remote"
enabled = true
origin_type = "local"
activation_rule_ref = "lexguard.default"

